<%- include('_head', { title: 'About', page: 'about' }) %>
<h1><%= about.title %></h1>
<p class="lead"><%= about.bio %></p>

<h2>Skills</h2>
<ul class="inline-list">
<% about.skills.forEach(function (skill) { %><li><%= skill %></li>
<% }); %>
</ul>

<h2>Background</h2>
<% String(about.background).split('\n').filter(function (para) { return para.trim(); }).forEach(function (para) { %>
<p><%= para.trim() %></p>
<% }); %>
<%- include('_foot') %>
